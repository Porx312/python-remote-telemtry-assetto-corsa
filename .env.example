# Supabase Postgres (misma lógica que ac-data; sslmode suele ser obligatorio)
DATABASE_URL=postgresql://postgres.PROJECT_REF:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Si ves cortes SSL / "connection closed unexpectedly", prueba verify-full o ajusta keepalives (ya se añaden por código).
# DATABASE_SSLMODE=require
# DATABASE_CONNECT_TIMEOUT=15
# DATABASE_KEEPALIVES_IDLE=30
# Alternativa al nombre anterior
# SUPABASE_DB_URL=

# Tests / DB de prueba
USE_TEST_DB=false
# TEST_DATABASE_URL=

# --- Solo si usas scripts/migrate_mysql_to_supabase.py contra MySQL antiguo ---
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=
# DB_NAME=ac_server_db
# DB_PORT=3306

# Misma API_KEY que el backend Node (ac-data) si envías peticiones autenticadas
API_KEY=cambia_esto_por_un_secreto_largo

# Rutas con server_cfg.ini (separadas por coma). Vacío si no usas esa función.
EVENTS_SERVERS_PATH=
SERVERS_PATH=
TIME_ATTACK_SERVERS_PATH=

BACKEND_URL=http://localhost:3000

# Webhooks hacia Convex u otro backend
EVENT_WEBHOOK_SECRET=
SERVER_EVENT_WEBHOOK_URL=

# Webhook server_status (puede ser lento). Por defecto 15.
# SERVER_STATUS_INTERVAL_SEC=60
# Timeout HTTP para webhooks generales (player_join/leave/lap/server_status).
# GENERAL_WEBHOOK_TIMEOUT_SEC=10
# Barrido CAR_INFO + purga por timeout (mejor dejar ~15; desacoplado del webhook).
# GHOST_CARINFO_POLL_INTERVAL_SEC=15
# Ms de espera tras los pings 201 antes de purgar por timeout (respuestas UDP).
# CAR_INFO_SETTLE_MS=400

# Battle en server abierto:
# false = no usar /restart_session global (evita mandar a todos a pits).
# BATTLE_USE_GLOBAL_RESTART=false
# En server abierto, evita usar /pit automático si hay más de 2 conectados.
# BATTLE_TARGETED_PIT_ONLY_WHEN_SERVER_HAS_2=true
# Comandos por jugador para mandar a pits/spectator (se prueban en orden).
# Placeholders: {car_id}, {steam_id}, {name}
# BATTLE_TARGETED_PIT_COMMANDS=/pit {car_id}
# BATTLE_TARGETED_PIT_DELAY_MS=120
# Modo recomendado si no quieres enviar nadie a pits:
# una sola partida continua, puntos acumulados hasta completar 100% de pista.
# BATTLE_SINGLE_SESSION_POINTS_MODE=true
# Solo punto al terminar (100% pista):
# si gap final >= este valor, punto para LEAD; si no, DRAW.
# BATTLE_FINISH_POINT_MIN_GAP_METERS=50
# Victoria por defecto si rival desaparece (disconnect/pits/teleport por gap):
# BATTLE_DISAPPEAR_GAP_METERS=250
# BATTLE_DEFAULT_WIN_MIN_POINTS=2
# Overtake/collision warnings:
# OVERTAKE_POINT_COOLDOWN_SEC=2.0
# OVERTAKE_MIN_GAP_METERS=10
# BATTLE_COLLISION_WARN_COOLDOWN_SEC=4.0
# Gap abort más preciso antes del lanzamiento (evita abortar si uno está quieto).
# BATTLE_PRESTART_GAP_ABORT_GRACE_SEC=2.0
# BATTLE_GAP_ABORT_MIN_BOTH_SPEED_KMH=20.0
